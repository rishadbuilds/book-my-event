# Backend environment
NODE_ENV=development
PORT=5001

MONGODB_URI=mongodb://127.0.0.1:27017/bookmyevent

# Use a long random value (min 16 chars) in real environments
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

FRONTEND_URL=http://localhost:5173

# Registration OTP policy
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Service image uploads (local disk in development)
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=6

# Optional SMTP. When omitted, OTPs are printed to the API console
# and returned as `devOtp` outside production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-user
# SMTP_PASS=your-password
# EMAIL_FROM=BookMyEvent <no-reply@example.com>

# Optional. `npm run seed` generates a random password when this is absent.
# SEED_PASSWORD=ChangeMe123
